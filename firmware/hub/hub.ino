// Hub (living room): Seeed XIAO ePaper Display Board EE05 (XIAO ESP32-S3 Plus) + 2.13" e-paper (SSD1680)
// + SHT41, on a LiPo.
//
// Each wake: read the SHT41 (before Wi-Fi warms the board), make ONE HTTPS call to the `sync` edge
// function, redraw the e-paper only if what it shows has changed, and deep sleep for as long as the
// server says. Any of the three keys wakes it, syncs, and shows today's weather for a minute.
//
// While a computer is connected over USB it stays awake between cycles instead of sleeping, so the
// Serial Monitor and uploading sketches keep working (build with SLEEP_ON_USB=1 to sleep anyway).
//
// Setup:
//   - Copy secrets.example.h to secrets.h (same folder) and fill it in. secrets.h is git-ignored.
//   - Library: Seeed_GFX2 (from GitHub, not the Library Manager).
//   - Board: XIAO_ESP32S3_PLUS, USB CDC On Boot = Enabled, PSRAM = OPI.
// fonts.h and art.h are generated by tools/hub_screen/export.js.
//
// Wiring: SHT41 VIN -> the 3V3 hole of the expansion header (switched together with the display),
//         GND -> GND, SDA -> D4 (GPIO5), SCL -> D5 (GPIO6).

#include <Wire.h>
#include <WiFi.h>
#include <WiFiClientSecure.h>
#include <HTTPClient.h>
#include <Preferences.h>
#include <esp_sleep.h>
#include <driver/gpio.h>
#include <driver/rtc_io.h>
#include <time.h>
#include <mbedtls/base64.h>
#include <Seeed_GFX.h>
#include "board/boards/XIAO_ePaper_Boards.h"
#include "panel/configs/Seeed_Panel_Configs.h"
#include "driver/epaper/Driver_SSD1680.h"
#include "panel/Panel_EPaper.h"
#include "secrets.h"

#define FW_VERSION "hub 0.6"
#ifndef SLEEP_ON_USB
#define SLEEP_ON_USB 0
#endif

Seeed_GFX display;
#include "screen.h"

// ---------- Settings ----------
const uint32_t DEFAULT_SLEEP_S = 300;     // when the server can't be reached or doesn't say
const uint32_t MIN_SLEEP_S = 60, MAX_SLEEP_S = 3600;
const uint8_t MAX_BACKOFF = 3;            // while the server can't be reached the interval doubles this many times (40 min)
const uint32_t WEATHER_PEEK_S = 60;       // how long the weather stays after a key press
const float BATTERY_LOW_V = 3.50f;        // the low-battery band comes on below this...
const float BATTERY_OK_V = 3.65f;         // ...and goes off above this
const float TEMP_STEP_C = 0.2f;           // the living-room values on screen only change by at least this much,
const float HUMIDITY_STEP = 2.0f;         // so sensor noise doesn't cost a redraw every 5 minutes
const uint8_t DHCP_EVERY_SYNCS = 48;      // reuse the last IP address this many times before asking the router again
const uint32_t WIFI_FAST_MS = 5000, WIFI_FULL_MS = 12000, HTTP_TIMEOUT_MS = 8000;
const uint32_t TLS_HANDSHAKE_S = 8;       // the default is 120 s of radio on a bad connection

// ---------- Pins ----------
const int PIN_SDA = 5;
const int PIN_SCL = 6;
// Key1, Key2, Key3 on the board (active low, 10k pull-ups there), plus an external push button between
// GPIO11 (4th hole of the right header row) and GND. It does what the keys do. The header has no
// always-on 3V3 for a pull-up resistor, so GPIO11 uses the chip's own pull-up, awake and asleep.
const int PIN_EXTERNAL_KEY = 11;
const int PIN_KEYS[4] = {2, 3, 8, PIN_EXTERNAL_KEY};
const uint64_t KEY_WAKE_MASK = (1ULL << 2) | (1ULL << 3) | (1ULL << 8) | (1ULL << PIN_EXTERNAL_KEY);
const int PIN_PANEL_RESET = 38;
const int PIN_PANEL_POWER = 43;           // switches the rail that feeds the display and the SHT41
const int PIN_BATTERY = 1;                // VBAT through a 10k/10k divider
const int PIN_BATTERY_ENABLE = 39;        // active high: connects the divider
const uint8_t SHT41_ADDRESS = 0x44;

enum Wake { WAKE_POWER, WAKE_TIMER, WAKE_KEY };

// What the server last told us; kept so the screen can be redrawn without another call
struct ServerData {
  bool valid;
  uint32_t receivedS;      // on the Hub's own counter
  bool roomKnown;
  float roomT, roomH, roomCo2;
  uint32_t roomAgeS;       // age of the bedroom reading when it was received
  bool weatherKnown;
  float outsideNow, outsideMax;
  uint8_t rainPercent, weatherCode;
  char place[16];
};

// RTC memory survives deep sleep; everything else starts over at each wake
RTC_DATA_ATTR ServerData server;
RTC_DATA_ATTR int32_t messageId = -1;       // the message stored in flash, -1 for none
RTC_DATA_ATTR bool co2Alarm = false;
RTC_DATA_ATTR bool batteryLow = false;
RTC_DATA_ATTR bool weatherPeek = false;     // showing the weather after a key press
RTC_DATA_ATTR float shownT = NAN, shownH = NAN;
RTC_DATA_ATTR uint32_t shownSignature = 0;  // what is on the panel now
RTC_DATA_ATTR int32_t shownMessageId = -1;  // the message on the panel now, -1 when it shows the weather
RTC_DATA_ATTR int32_t seenMessageId = -1;   // a "seen" still to be reported to the server
RTC_DATA_ATTR uint8_t syncFailures = 0;     // syncs failed in a row
RTC_DATA_ATTR uint32_t nextSyncS = 0;
RTC_DATA_ATTR uint32_t lastAwakeMs = 0;
RTC_DATA_ATTR uint32_t wakes = 0;
// What the last good connection looked like, to skip the scan and the address request next time
RTC_DATA_ATTR bool apKnown = false;
RTC_DATA_ATTR uint8_t apBssid[6];
RTC_DATA_ATTR uint8_t apChannel = 0;
RTC_DATA_ATTR uint32_t ipLocal = 0, ipGateway = 0, ipSubnet = 0, ipDns = 0;
RTC_DATA_ATTR uint8_t syncsSinceDhcp = 0;

uint8_t messageBits[MESSAGE_BYTES];
bool displayReady = false;

bool usbConnected() {
  return HWCDC::isPlugged();
}

uint32_t nowSeconds() {
  return (uint32_t)time(nullptr);
}

// ---------- Sensors ----------

void powerRail(bool on) {
  pinMode(PIN_PANEL_POWER, OUTPUT);
  digitalWrite(PIN_PANEL_POWER, on ? HIGH : LOW);
  if (on) delay(10);  // the SHT41 needs 1 ms after power-up; the rail itself needs a moment too
}

// High-precision measurement; false if the sensor doesn't answer or a checksum is wrong
bool readSht41(float& tempC, float& humidity) {
  Wire.beginTransmission(SHT41_ADDRESS);
  Wire.write(0xFD);
  if (Wire.endTransmission() != 0) return false;
  delay(10);
  uint8_t b[6];
  if (Wire.requestFrom(SHT41_ADDRESS, (uint8_t)6) != 6) return false;
  for (int i = 0; i < 6; i++) b[i] = Wire.read();
  for (int word = 0; word < 2; word++) {
    uint8_t crc = 0xFF;
    for (int i = 0; i < 2; i++) {
      crc ^= b[word * 3 + i];
      for (int bit = 0; bit < 8; bit++) crc = crc & 0x80 ? (crc << 1) ^ 0x31 : crc << 1;
    }
    if (crc != b[word * 3 + 2]) return false;
  }
  tempC = -45.0f + 175.0f * ((b[0] << 8) | b[1]) / 65535.0f;
  humidity = constrain(-6.0f + 125.0f * ((b[3] << 8) | b[4]) / 65535.0f, 0.0f, 100.0f);
  return true;
}

// The divider is only connected while the enable pin is high, so it draws nothing in between
float readBatteryVolts() {
  pinMode(PIN_BATTERY_ENABLE, OUTPUT);
  digitalWrite(PIN_BATTERY_ENABLE, HIGH);
  delay(20);
  uint32_t sum = 0;
  for (int i = 0; i < 16; i++) sum += analogReadMilliVolts(PIN_BATTERY);
  digitalWrite(PIN_BATTERY_ENABLE, LOW);
  return sum / 16 / 1000.0f * 2.0f;
}

// ---------- Message storage ----------
// The bitmap lives in flash so it survives a flat battery; RTC memory only remembers which one it is.

void loadMessage() {
  Preferences prefs;
  prefs.begin("hub", true);
  int32_t id = prefs.getInt("msg", -1);
  bool ok = id >= 0 && prefs.getBytes("bmp", messageBits, MESSAGE_BYTES) == MESSAGE_BYTES;
  prefs.end();
  messageId = ok ? id : -1;
}

void storeMessage(int32_t id) {
  Preferences prefs;
  prefs.begin("hub", false);
  bool ok = true;
  if (id >= 0) {
    ok = prefs.putBytes("bmp", messageBits, MESSAGE_BYTES) == MESSAGE_BYTES && prefs.putInt("msg", id) > 0;
    if (!ok) prefs.remove("msg");
  } else {
    prefs.remove("msg");
  }
  prefs.end();
  // If the flash write failed the Hub claims no message, so the server sends the bitmap again next time
  messageId = ok ? id : -1;
}

// ---------- Wi-Fi ----------

bool waitForWiFi(uint32_t timeoutMs) {
  uint32_t startedMs = millis();
  while (WiFi.status() != WL_CONNECTED && millis() - startedMs < timeoutMs) delay(20);
  return WiFi.status() == WL_CONNECTED;
}

bool connectWiFi() {
  uint32_t startedMs = millis();
  WiFi.persistent(false);
  WiFi.mode(WIFI_STA);

  if (apKnown) {
    // Known channel and access point: no scan. Known address: no waiting for the router to hand one out.
    const bool reuseAddress = ipLocal != 0 && syncsSinceDhcp < DHCP_EVERY_SYNCS;
    if (reuseAddress) WiFi.config(IPAddress(ipLocal), IPAddress(ipGateway), IPAddress(ipSubnet), IPAddress(ipDns));
    WiFi.begin(WIFI_SSID, WIFI_PASSWORD, apChannel, apBssid, true);
    if (waitForWiFi(WIFI_FAST_MS)) {
      syncsSinceDhcp = reuseAddress ? syncsSinceDhcp + 1 : 0;
    } else {
      Serial.println("  quick Wi-Fi connection failed, starting over");
      apKnown = false;
      ipLocal = 0;
      WiFi.disconnect(true);
      WiFi.config(IPAddress((uint32_t)0), IPAddress((uint32_t)0), IPAddress((uint32_t)0));  // back to asking the router
    }
  }
  if (WiFi.status() != WL_CONNECTED) {
    WiFi.begin(WIFI_SSID, WIFI_PASSWORD);
    if (!waitForWiFi(WIFI_FULL_MS)) {
      Serial.printf("  Wi-Fi failed after %u ms\n", (unsigned)(millis() - startedMs));
      WiFi.disconnect(true);
      WiFi.mode(WIFI_OFF);
      return false;
    }
    syncsSinceDhcp = 0;
  }

  memcpy(apBssid, WiFi.BSSID(), 6);
  apChannel = WiFi.channel();
  apKnown = true;
  ipLocal = (uint32_t)WiFi.localIP();
  ipGateway = (uint32_t)WiFi.gatewayIP();
  ipSubnet = (uint32_t)WiFi.subnetMask();
  ipDns = (uint32_t)WiFi.dnsIP();
  Serial.printf("  Wi-Fi up in %u ms, %d dBm\n", (unsigned)(millis() - startedMs), WiFi.RSSI());
  return true;
}

void disconnectWiFi() {
  WiFi.disconnect(true);
  WiFi.mode(WIFI_OFF);
}

// ---------- Sync ----------

// The value of "key" in the server's flat JSON answer, as text. False if it is missing or null.
bool jsonValue(const String& json, const char* key, String& out) {
  String pattern = String("\"") + key + "\":";
  int at = json.indexOf(pattern);
  if (at < 0) return false;
  int start = at + pattern.length();
  if (start < (int)json.length() && json[start] == '"') {
    int end = json.indexOf('"', start + 1);
    if (end < 0) return false;
    out = json.substring(start + 1, end);
    return true;
  }
  int end = start;
  while (end < (int)json.length() && json[end] != ',' && json[end] != '}') end++;
  out = json.substring(start, end);
  out.trim();
  return out.length() > 0 && out != "null";
}

bool jsonNumber(const String& json, const char* key, float& out) {
  String text;
  if (!jsonValue(json, key, text)) return false;
  out = text.toFloat();
  return true;
}

// Decodes a new message into messageBits. False (and messageBits untouched) unless it is exactly the right size.
bool decodeMessage(const String& base64) {
  static uint8_t decoded[MESSAGE_BYTES + 4];
  size_t length = 0;
  int result = mbedtls_base64_decode(decoded, sizeof(decoded), &length, (const unsigned char*)base64.c_str(), base64.length());
  if (result != 0 || length != MESSAGE_BYTES) {
    Serial.printf("  message bitmap rejected (result %d, %u bytes)\n", result, (unsigned)length);
    return false;
  }
  memcpy(messageBits, decoded, MESSAGE_BYTES);
  return true;
}

void appendNumber(String& s, const char* key, float v, unsigned decimals) {
  if (isnan(v)) return;
  s += ",\"";
  s += key;
  s += "\":";
  s += String(v, decimals);
}

// One call: sends the Hub's reading, gets everything it needs to draw. Returns the seconds to sleep, or 0 on failure.
uint32_t sync(float tempC, float humidity, float batteryV) {
  if (!connectWiFi()) return 0;

  String body = "{\"id\":\"" DEVICE_ID "\",\"key\":\"" DEVICE_KEY "\",\"fw\":\"" FW_VERSION "\"";
  appendNumber(body, "t", tempC, 2);
  appendNumber(body, "h", humidity, 1);
  appendNumber(body, "bv", batteryV, 2);
  body += ",\"rssi\":";
  body += WiFi.RSSI();
  body += ",\"ms\":";
  body += lastAwakeMs;
  if (messageId >= 0) {
    body += ",\"have\":";
    body += messageId;
  }
  if (seenMessageId >= 0) {
    body += ",\"seen\":";
    body += seenMessageId;
  }
  body += "}";

  WiFiClientSecure client;
  client.setInsecure();  // traffic is encrypted, but the server certificate isn't verified
  client.setHandshakeTimeout(TLS_HANDSHAKE_S);
  HTTPClient http;
  http.begin(client, SUPABASE_URL "/functions/v1/sync");
  http.addHeader("Content-Type", "application/json");
  http.setTimeout(HTTP_TIMEOUT_MS);
  uint32_t startedMs = millis();
  int code = http.POST(body);
  String answer = code > 0 ? http.getString() : String();
  http.end();
  disconnectWiFi();
  if (code != 200) {
    Serial.printf("  sync failed: HTTP %d %s\n", code, answer.substring(0, 120).c_str());
    // Connected but no answer at all: the remembered address may belong to another device by now
    if (code < 0) ipLocal = 0;
    return 0;
  }
  Serial.printf("  sync ok in %u ms, %u bytes\n", (unsigned)(millis() - startedMs), (unsigned)answer.length());
  seenMessageId = -1;  // reported

  server.valid = true;
  server.receivedS = nowSeconds();
  float v;
  server.roomKnown = jsonNumber(answer, "age", v);
  if (server.roomKnown) {
    server.roomAgeS = (uint32_t)v;
    server.roomT = jsonNumber(answer, "t", v) ? v : NAN;
    server.roomH = jsonNumber(answer, "h", v) ? v : NAN;
    server.roomCo2 = jsonNumber(answer, "c", v) ? v : NAN;
  }
  server.weatherKnown = jsonNumber(answer, "wn", v);
  if (server.weatherKnown) {
    server.outsideNow = v;
    server.outsideMax = jsonNumber(answer, "wx", v) ? v : server.outsideNow;
    server.rainPercent = jsonNumber(answer, "wr", v) ? (uint8_t)constrain(v, 0.0f, 100.0f) : 0;
    server.weatherCode = jsonNumber(answer, "wc", v) ? (uint8_t)constrain(v, 0.0f, 255.0f) : 3;
  }
  String text;
  if (jsonValue(answer, "place", text)) {
    text.toUpperCase();
    strlcpy(server.place, text.c_str(), sizeof(server.place));
  }

  // The message: its bitmap comes only when it is not the one already stored
  if (jsonNumber(answer, "msg", v)) {
    int32_t id = (int32_t)v;
    if (id != messageId && jsonValue(answer, "bmp", text) && decodeMessage(text)) {
      storeMessage(id);
      Serial.printf("  new message %d stored\n", (int)id);
    }
  } else if (messageId >= 0) {
    storeMessage(-1);
    Serial.println("  message cleared");
  }

  return jsonNumber(answer, "sleep", v) ? constrain((uint32_t)v, MIN_SLEEP_S, MAX_SLEEP_S) : DEFAULT_SLEEP_S;
}

// ---------- Screen ----------

ScreenState composeScreen(bool sensorOk, uint32_t now) {
  ScreenState s = {};
  s.livingKnown = sensorOk || !isnan(shownT);
  s.living = {shownT, shownH};

  s.bedroomKnown = server.valid && server.roomKnown && !isnan(server.roomCo2) && !isnan(server.roomT);
  if (s.bedroomKnown) {
    s.bedroom = {server.roomT, server.roomH};  // humidity may be missing: drawn as --%
    s.co2Ppm = server.roomCo2;
    s.bedroomAgeMin = (uint16_t)min<uint32_t>((server.roomAgeS + (now - server.receivedS)) / 60, 65000);
  }
  // An old reading says nothing about the air now, so it never keeps APRI FINESTRA on
  const bool fresh = s.bedroomKnown && s.bedroomAgeMin <= STALE_MINUTES;
  co2Alarm = fresh ? nextCo2Alarm(co2Alarm, s.co2Ppm) : false;
  s.co2Alarm = co2Alarm;

  s.weatherKnown = server.valid && server.weatherKnown;
  s.outsideNowC = server.outsideNow;
  s.outsideMaxC = server.outsideMax;
  s.rainPercent = server.rainPercent;
  s.weatherCode = server.weatherCode;
  strlcpy(s.place, server.place, sizeof(s.place));

  s.showMessage = messageId >= 0 && !weatherPeek;
  s.batteryLow = batteryLow;
  return s;
}

// A number that changes exactly when the picture would: everything that is drawn, at the precision it is drawn
uint32_t screenSignature(const ScreenState& s) {
  const auto tenths = [](float v) { return isnan(v) ? INT32_MIN : (int32_t)lroundf(v * 10); };
  const auto whole = [](float v) { return isnan(v) ? INT32_MIN : (int32_t)lroundf(v); };
  // The number in the stale label: hours up to 47, then days (see ageLabel() in screen.h)
  const int32_t staleHours = (s.bedroomAgeMin + 30) / 60;
  const int32_t ageShown = !s.bedroomKnown || s.bedroomAgeMin <= STALE_MINUTES ? 0
                           : staleHours < 48 ? staleHours : 1000 + min<int32_t>(99, (staleHours + 12) / 24);
  const bool weatherDrawn = !s.showMessage;  // behind a message the weather isn't visible, so it mustn't cause a redraw
  int32_t parts[] = {
    s.livingKnown, tenths(s.living.tempC), whole(s.living.humidity),
    s.bedroomKnown, tenths(s.bedroom.tempC), whole(s.bedroom.humidity), whole(s.co2Ppm), ageShown,
    s.co2Alarm, s.showMessage, s.showMessage ? messageId : -1,
    weatherDrawn && s.weatherKnown, weatherDrawn && s.weatherKnown ? whole(s.outsideNowC) : 0,
    weatherDrawn && s.weatherKnown ? whole(s.outsideMaxC) : 0, weatherDrawn && s.weatherKnown ? s.rainPercent : 0,
    weatherDrawn && s.weatherKnown ? (int32_t)weatherIconFor(s.weatherCode) : -1,
    s.batteryLow,
  };
  uint32_t hash = 2166136261u;
  const uint8_t* bytes = (const uint8_t*)parts;
  for (size_t i = 0; i < sizeof(parts); i++) hash = (hash ^ bytes[i]) * 16777619u;
  if (weatherDrawn) {
    for (const char* p = s.place; *p; p++) hash = (hash ^ (uint8_t)*p) * 16777619u;
  }
  return hash ? hash : 1;  // 0 means "nothing drawn yet"
}

bool showScreen(const ScreenState& s) {
  uint32_t startedMs = millis();
  if (!displayReady) {
    // Seeed_GFX2 sets the reset pin up with gpio_set_direction() but pulses it with digitalWrite(), and the
    // ESP32 core ignores digitalWrite() on a pin that never went through pinMode(). Without this the panel
    // is never reset, and an update on a panel that is still asleep times out (2 x 30 s).
    pinMode(PIN_PANEL_RESET, OUTPUT);
    digitalWrite(PIN_PANEL_RESET, HIGH);
    if (!display.begin<Board_XIAO_ePaper_EE05, Config_Seeed_ePaper_2inch13_BW_SSD1680>()) {
      Serial.printf("  display failed: %s\n", display.lastResult().message);
      return false;
    }
    display.setRotation(3);  // 250x122, long edge horizontal
    displayReady = true;
  }
  drawScreen(s, s.showMessage ? messageBits : nullptr);
  display.update();
  Serial.printf("  screen redrawn in %u ms (%s)\n", (unsigned)(millis() - startedMs), s.showMessage ? "message" : "weather");
  return true;
}

// ---------- Main ----------

// Does one wake's work and returns how many seconds to sleep
uint32_t runCycle(Wake wake) {
  const uint32_t startedMs = millis();
  const uint32_t now = nowSeconds();
  Serial.printf("Wake %u (%s)\n", (unsigned)wakes, wake == WAKE_KEY ? "key" : wake == WAKE_TIMER ? "timer" : "power-on");

  // Sensors first, before the radio warms the board
  powerRail(true);
  Wire.begin(PIN_SDA, PIN_SCL);
  float t = NAN, h = NAN;
  bool sensorOk = readSht41(t, h);
  if (!sensorOk) {  // straight after the rail comes up the first try can be too early
    delay(20);
    sensorOk = readSht41(t, h);
  }
  const float batteryV = readBatteryVolts();
  if (sensorOk) {
    if (isnan(shownT) || fabsf(t - shownT) >= TEMP_STEP_C) shownT = t;
    if (isnan(shownH) || fabsf(h - shownH) >= HUMIDITY_STEP) shownH = h;
  }
  if (batteryV < BATTERY_LOW_V) batteryLow = true;
  else if (batteryV > BATTERY_OK_V) batteryLow = false;
  Serial.printf("  living room %.2f C %.1f %%%s, battery %.2f V\n", t, h, sensorOk ? "" : " (SHT41 did not answer)", batteryV);

  // A key pressed while a message is on the panel means it has been seen. It is reported with the next
  // sync that works, so a failed call doesn't lose it.
  if (wake == WAKE_KEY && shownMessageId >= 0) seenMessageId = shownMessageId;

  // The weather peek ends by itself after WEATHER_PEEK_S, or at once with a second key press.
  // Either way the wake only puts the message back, which doesn't need the server.
  const bool peekEnds = weatherPeek && (wake == WAKE_TIMER || wake == WAKE_KEY);
  if (peekEnds) weatherPeek = false;
  if (!peekEnds || !server.valid || now >= nextSyncS) {
    const uint32_t sleepS = sync(t, h, batteryV);
    if (sleepS) {
      syncFailures = 0;
      nextSyncS = nowSeconds() + sleepS;
    } else {
      // Server or Wi-Fi down: each failure costs seconds of radio, so try less and less often
      nextSyncS = nowSeconds() + min<uint32_t>(DEFAULT_SLEEP_S << min<uint8_t>(syncFailures, MAX_BACKOFF), MAX_SLEEP_S);
      if (syncFailures < 255) syncFailures++;
    }
  }
  // With no message the weather is the main view anyway
  if (wake == WAKE_KEY && messageId >= 0 && !peekEnds) weatherPeek = true;

  // The bitmap has to be in memory before deciding what the screen shows: if it can't be read back,
  // the Hub forgets it (the server then sends it again) and shows the weather meanwhile
  if (messageId >= 0 && !weatherPeek) loadMessage();
  ScreenState screen = composeScreen(sensorOk, nowSeconds());
  const uint32_t signature = screenSignature(screen);
  if (signature != shownSignature) {
    if (showScreen(screen)) {
      shownSignature = signature;
      shownMessageId = screen.showMessage ? messageId : -1;
    }
  } else {
    Serial.println("  nothing changed on screen");
  }

  wakes++;
  lastAwakeMs = millis() - startedMs;
  const uint32_t after = nowSeconds();
  if (weatherPeek) return WEATHER_PEEK_S;
  return nextSyncS > after + MIN_SLEEP_S ? nextSyncS - after : MIN_SLEEP_S;
}

void sleepFor(uint32_t seconds) {
  powerRail(false);  // display and SHT41 off
  pinMode(PIN_BATTERY_ENABLE, OUTPUT);
  digitalWrite(PIN_BATTERY_ENABLE, LOW);
  // Keep both switches off through the sleep instead of leaving the pins floating
  gpio_hold_en((gpio_num_t)PIN_PANEL_POWER);
  gpio_hold_en((gpio_num_t)PIN_BATTERY_ENABLE);
  gpio_deep_sleep_hold_en();

  esp_sleep_enable_timer_wakeup(seconds * 1000000ULL);
  // The key wake-up is level-triggered: a key that is still down (held, or jammed by the case) would
  // wake the Hub again at once, over and over. In that case this sleep ends by timer only.
  bool keyDown = false;
  for (int pin : PIN_KEYS) keyDown = keyDown || digitalRead(pin) == LOW;
  // The external button's pull-up has to stay on in deep sleep, or the open pin would float and wake the Hub
  rtc_gpio_init((gpio_num_t)PIN_EXTERNAL_KEY);
  rtc_gpio_set_direction((gpio_num_t)PIN_EXTERNAL_KEY, RTC_GPIO_MODE_INPUT_ONLY);
  rtc_gpio_pulldown_dis((gpio_num_t)PIN_EXTERNAL_KEY);
  rtc_gpio_pullup_en((gpio_num_t)PIN_EXTERNAL_KEY);
  esp_sleep_pd_config(ESP_PD_DOMAIN_RTC_PERIPH, ESP_PD_OPTION_ON);
  if (!keyDown) esp_sleep_enable_ext1_wakeup_io(KEY_WAKE_MASK, ESP_EXT1_WAKEUP_ANY_LOW);
  else Serial.println("  a key is down: sleeping without the key wake-up");
  esp_deep_sleep_start();
}

uint32_t sleepSeconds = DEFAULT_SLEEP_S;

void setup() {
  setCpuFrequencyMhz(80);  // plenty for this job
  Serial.begin(115200);
  // Undo what the last sleep left behind: the held switches, and the key pins in their wake-up role
  gpio_deep_sleep_hold_dis();
  gpio_hold_dis((gpio_num_t)PIN_PANEL_POWER);
  gpio_hold_dis((gpio_num_t)PIN_BATTERY_ENABLE);
  for (int pin : PIN_KEYS) {
    rtc_gpio_deinit((gpio_num_t)pin);
    pinMode(pin, pin == PIN_EXTERNAL_KEY ? INPUT_PULLUP : INPUT);
  }

  Wake wake = WAKE_POWER;
  if (esp_reset_reason() == ESP_RST_DEEPSLEEP) {
    wake = esp_sleep_get_wakeup_cause() == ESP_SLEEP_WAKEUP_EXT1 ? WAKE_KEY : WAKE_TIMER;
  } else {
    // Power-up, reset button or a new sketch: start clean, but keep the message that is in flash
    server = {};
    co2Alarm = batteryLow = weatherPeek = false;
    shownT = shownH = NAN;
    shownSignature = 0;
    shownMessageId = seenMessageId = -1;
    syncFailures = 0;
    nextSyncS = 0;
    apKnown = false;
    wakes = 0;
    loadMessage();
    delay(300);  // the USB port needs a moment before it can tell whether a computer is there
    const bool stayingAwake = usbConnected() && !SLEEP_ON_USB;
    if (stayingAwake) delay(1200);  // time for the Serial Monitor to attach
    const esp_reset_reason_t reason = esp_reset_reason();
    Serial.printf("\nHub starting (" FW_VERSION "), reset reason %d\n", (int)reason);
    const bool crashed = reason == ESP_RST_BROWNOUT || reason == ESP_RST_PANIC || reason == ESP_RST_INT_WDT ||
                         reason == ESP_RST_TASK_WDT || reason == ESP_RST_WDT;
    if (crashed && !stayingAwake) {
      // A weak battery that browns out when the radio starts would otherwise reset and try again every
      // few seconds until it is flat. Sleep first.
      sleepFor(DEFAULT_SLEEP_S);
    }
  }
  sleepSeconds = runCycle(wake);
}

void loop() {
  if (SLEEP_ON_USB || !usbConnected()) {
    // Test builds that sleep on USB: keep the port up a few seconds so a new sketch can still be uploaded
    if (SLEEP_ON_USB && usbConnected()) delay(5000);
    sleepFor(sleepSeconds);
  }

  // On USB: wait out the sleep time awake, watching the keys
  Serial.printf("USB connected: staying awake, next cycle in %u s\n", (unsigned)sleepSeconds);
  const uint32_t startedMs = millis();
  Wake wake = WAKE_TIMER;
  while (millis() - startedMs < sleepSeconds * 1000UL) {
    bool pressed = false;
    for (int pin : PIN_KEYS) pressed = pressed || digitalRead(pin) == LOW;
    if (pressed) {
      delay(30);  // contact bounce
      wake = WAKE_KEY;
      const uint32_t pressedMs = millis();
      while (millis() - pressedMs < 3000 &&
             (digitalRead(PIN_KEYS[0]) == LOW || digitalRead(PIN_KEYS[1]) == LOW || digitalRead(PIN_KEYS[2]) == LOW || digitalRead(PIN_KEYS[3]) == LOW)) delay(10);
      break;
    }
    delay(20);
  }
  sleepSeconds = runCycle(wake);
}
