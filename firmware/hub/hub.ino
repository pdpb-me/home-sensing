// Hub: Seeed XIAO ePaper Display Board EE05 (XIAO ESP32-S3 Plus) + 2.13" e-paper (SSD1680) + SHT41.
//
// Phase 2: every screen state of HANDOFF.md section 6 with made-up data. Any key shows the next state.
// No Wi-Fi, no sleep yet.
//
// Board settings: XIAO_ESP32S3_PLUS, USB CDC On Boot = Enabled, PSRAM = OPI.
// Library: Seeed_GFX2 (from GitHub, not the Library Manager).
// fonts.h and art.h are generated by tools/hub_screen/export.js.

#include <Seeed_GFX.h>
#include "board/boards/XIAO_ePaper_Boards.h"
#include "panel/configs/Seeed_Panel_Configs.h"
#include "driver/epaper/Driver_SSD1680.h"
#include "panel/Panel_EPaper.h"

Seeed_GFX display;
#include "screen.h"

// ---------- Pins ----------
const int PIN_KEYS[3] = {2, 3, 8};  // Key1, Key2, Key3: active low, 10k pull-ups on the board
const int PIN_PANEL_RESET = 38;

// ---------- Keys ----------
// All three keys do the same thing. A small task of its own watches them, because loop() is stuck for
// about 2.3 s whenever the display redraws and would miss presses made in that time.
const uint32_t KEY_POLL_MS = 5;
const uint8_t KEY_STABLE_POLLS = 4;  // a level has to hold for 20 ms to count: contact bounce is shorter
volatile uint32_t keyPresses = 0;
volatile uint8_t lastKey = 0;

void keyTask(void*) {
  bool down[3] = {false, false, false};
  uint8_t changedFor[3] = {0, 0, 0};
  for (;;) {
    for (int i = 0; i < 3; i++) {
      const bool low = digitalRead(PIN_KEYS[i]) == LOW;
      if (low == down[i]) {
        changedFor[i] = 0;
      } else if (++changedFor[i] >= KEY_STABLE_POLLS) {
        down[i] = low;
        changedFor[i] = 0;
        if (low) {
          lastKey = i + 1;
          keyPresses = keyPresses + 1;
        }
      }
    }
    vTaskDelay(pdMS_TO_TICKS(KEY_POLL_MS));
  }
}

// ---------- Demo states ----------
struct DemoState {
  const char* name;
  ScreenState screen;  // co2Alarm is worked out while stepping through, to show the hysteresis
};

//                                      living        bedroom     CO2  age  alarm  message  now  max rain  battery low
DemoState demo[] = {
  {"message, all normal",            {{21.4, 48}, {19.8, 55},  870,   4, false, true,    9, 13,  70, false}},
  {"weather after a key press",      {{21.4, 48}, {19.8, 55},  870,   4, false, false,   9, 13,  70, false}},
  {"CO2 high, bedroom wet",          {{21.6, 47}, {20.9, 61}, 1480,   4, false, true,    9, 13,  70, false}},
  {"CO2 1200: still open window",    {{21.6, 47}, {20.7, 58}, 1200,   4, false, true,    9, 13,  70, false}},
  {"CO2 990: back to normal",        {{21.5, 47}, {20.2, 55},  990,   4, false, true,    9, 13,  70, false}},
  {"bedroom data 2 h old, dry, low battery, no message", {{20.8, 34}, {19.2, 57}, 790, 120, false, false, 9, 13, 70, true}},
  {"message with low battery",       {{21.4, 48}, {19.8, 55},  870,   4, false, true,    9, 13,  70, true}},
  {"widest values",                  {{20.0, 100}, {28.8, 38}, 2888,  4, false, false, -10, 28, 100, false}},
};
const size_t DEMO_COUNT = sizeof(demo) / sizeof(demo[0]);

size_t demoIndex = 0;
bool co2Alarm = false;
uint32_t shownPresses = 0;

void showDemoState() {
  DemoState& d = demo[demoIndex];
  co2Alarm = demoIndex == 0 ? false : nextCo2Alarm(co2Alarm, d.screen.co2Ppm);
  d.screen.co2Alarm = co2Alarm;

  uint32_t startedMs = millis();
  drawScreen(d.screen, ART_MESSAGE_SAMPLE);
  uint32_t drawnMs = millis();
  display.update();
  Serial.printf("State %u/%u: %s  (drawn in %u ms, panel update %u ms)\n", (unsigned)(demoIndex + 1),
                (unsigned)DEMO_COUNT, d.name, (unsigned)(drawnMs - startedMs), (unsigned)(millis() - drawnMs));
}

void setup() {
  Serial.begin(115200);
  delay(1500);
  Serial.println("\nHub starting (phase 2: screens with made-up data)");

  // Seeed_GFX2 sets the reset pin up with gpio_set_direction() but pulses it with digitalWrite(), and the
  // ESP32 core ignores digitalWrite() on a pin that never went through pinMode(). Without this the panel
  // is never reset out of deep sleep, so every update after the first one times out (2 x 30 s).
  pinMode(PIN_PANEL_RESET, OUTPUT);
  digitalWrite(PIN_PANEL_RESET, HIGH);

  if (!display.begin<Board_XIAO_ePaper_EE05, Config_Seeed_ePaper_2inch13_BW_SSD1680>()) {
    Serial.printf("Display failed: %s\n", display.lastResult().message);
    return;
  }
  display.setRotation(3);  // 250x122, long edge horizontal
  Serial.printf("Display %d x %d\n", display.width(), display.height());

  for (int pin : PIN_KEYS) pinMode(pin, INPUT);
  xTaskCreate(keyTask, "keys", 2048, nullptr, 2, nullptr);  // priority above loop(), so a redraw can't starve it
  showDemoState();
}

void loop() {
  const uint32_t presses = keyPresses;
  if (presses != shownPresses) {
    Serial.printf("Key%u pressed\n", (unsigned)lastKey);
    shownPresses = presses;  // presses made during a redraw are folded into one step
    demoIndex = (demoIndex + 1) % DEMO_COUNT;
    showDemoState();
  }
  delay(10);
}
